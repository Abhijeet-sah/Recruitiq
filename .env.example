# Database Configuration
# Local SQLite (Zero-config instant development):
DATABASE_URL=sqlite:///./recruitiq.db
# Or PostgreSQL for Docker / Production:
# DATABASE_URL=postgresql://recruitiq:recruitiq_secret_2026@localhost:5432/recruitiq

# Security & JWT
SECRET_KEY=recruitiq-secret-key-super-secure-production-ready-2026-xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Services
AI_PROVIDER=local
# Optional external AI providers:
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Storage
UPLOAD_DIR=./uploads/resumes
MAX_FILE_SIZE_MB=10

# Docker Postgres variables
POSTGRES_USER=recruitiq
POSTGRES_PASSWORD=recruitiq_secret_2026
POSTGRES_DB=recruitiq
